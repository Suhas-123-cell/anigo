# API Configuration
# Replace with your actual API URL (e.g., localhost, zrok tunnel, or production server)
EXPO_PUBLIC_API_URL=http://localhost:3000/api

# Google Maps API Key
# Get your key from: https://console.cloud.google.com/
# Then restrict it to your app's bundle ID and package name in Google Cloud Console
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
